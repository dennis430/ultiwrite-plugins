{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16", "outDir": "out", "rootDir": "src",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "sourceMap": false, "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts"]
}
