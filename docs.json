        "javascript",
        "typescript",
        "python",
        "java",
        "csharp",
        "go",
        "php",
        "ruby"
      ],
      "prefill": false,
      "autogenerate": false
    },
    "url": "full"
  },
  "navbar": {
    "links": [
      {
        "href": "https://dwsoffshorepartners.com/docs",
        "label": "Product documentation"
      },
      {
