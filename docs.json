{
  "theme": "mint",
  "name": "Ultiwrite API documentation",
  "description": "Integrate Ultiwrite asymmetric diligence and investigative intelligence with authorized evidence uploads, saved investigations, reports and webhooks.",
  "colors": {
    "primary": "#D39891",
    "light": "#E7B7B0",
    "dark": "#9A645E"
